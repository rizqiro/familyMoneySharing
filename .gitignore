.DS_Store

# Per-project Firebase files, written by `flutterfire configure`.
# lib/firebase_options.dart is committed as a placeholder and is safe to
# commit once generated - those API keys are public identifiers, and access is
# controlled by the Firestore security rules, not by hiding them.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log

# Local env
*.env
.env.local

# Coverage
coverage/
# Widget Preview related
.widget_preview/

# Rendered page snapshots, written by `flutter test --tags render
# --update-goldens`. Generated artefacts, and font rasterisation differs
# between Linux, macOS and Windows, so a PNG written on one machine will not
# match on another. Regenerate them locally instead of committing them.
test/render/
