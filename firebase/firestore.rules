rules_version = '2';

// Access control for Family Money.
//
// The model in one line: a household is the unit of sharing, membership is the
// read gate, and the few actions that are *not* symmetric between the two
// members (who may carve a budget into categories, who may confirm an
// allocation) are enforced here rather than only in the UI.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && uid() in household(hid).memberIds;
    }

    function budget(hid, bid) {
      return get(/databases/$(database)/documents/households/$(hid)/budgets/$(bid)).data;
    }

    function controlsBudget(hid, bid) {
      return budget(hid, bid).controllerId == uid();
    }

    // The last person left in a household may clear it out.
    //
    // This is what makes "delete my account and erase everything" possible.
    // The ordinary delete rules are per-owner - you may remove a budget you
    // control - which is right while two people share the place and wrong
    // once you are the only one in it: the other member's budgets would be
    // undeletable forever, by anybody.
    //
    // Being alone is checked against the household document itself rather
    // than trusted from the client, so it cannot be claimed.
    function soleMember(hid) {
      return signedIn() && household(hid).memberIds == [uid()];
    }

    // Which keys a write changed.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --------------------------------------------------------------- users
    // A profile is private to its owner. Partner names and emails are read
    // from the household's denormalised `members` map instead, so nobody needs
    // read access to anyone else's user document.
    match /users/{userId} {
      allow read: if signedIn() && userId == uid();
      allow create: if signedIn()
                    && userId == uid()
                    && request.resource.data.householdId == null;
      allow update: if signedIn() && userId == uid();

      // You may erase your own profile, and only your own. Required by the
      // app stores, and the right default regardless of them.
      allow delete: if signedIn() && userId == uid();
    }

    // ---------------------------------------------------------- households
    match /households/{hid} {

      // The joiner is not a member yet, so possession of a live invite is the
      // credential. The code travels in `joinedVia` because rules cannot see
      // anything the request does not carry.
      function joiningWithValidInvite() {
        let code = request.resource.data.joinedVia;
        let invite = get(/databases/$(database)/documents/invites/$(code)).data;
        return code is string
               && invite.householdId == hid
               && invite.acceptedBy == null
               && invite.expiresAt > request.time;
      }

      // `resource.data` is readable here even though the joiner has no read
      // access to the document, which is what lets these checks work. The
      // client sends the new membership in full rather than as an arrayUnion,
      // so what is compared is the literal resulting array.
      function addsOnlySelfAsMember() {
        return !(uid() in resource.data.memberIds)
               && uid() in request.resource.data.memberIds
               && request.resource.data.memberIds.hasAll(resource.data.memberIds)
               && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
               && request.resource.data.memberIds.size() <= 2;
      }

      allow read: if signedIn() && uid() in resource.data.memberIds;

      allow create: if signedIn()
                    && request.resource.data.memberIds == [uid()]
                    && request.resource.data.createdBy == uid();

      allow update: if signedIn() && (
                      uid() in resource.data.memberIds
                      || (addsOnlySelfAsMember() && joiningWithValidInvite())
                    );

      // Only ever the last member tidying up an empty household.
      allow delete: if signedIn() && resource.data.memberIds == [uid()];

      // ------------------------------------------------------- budgets
      match /budgets/{bid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
                      && request.resource.data.createdBy == uid();
        // Its controller decides what happens to it - including handing
        // control to the other member.
        allow update: if isMember(hid)
                      && resource.data.controllerId == uid();
        allow delete: if (isMember(hid)
                          && resource.data.controllerId == uid())
                      || soleMember(hid);
      }

      // ---------------------------------------------------- categories
      match /categories/{cid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid)
                      && request.resource.data.createdBy == uid()
                      && controlsBudget(hid, request.resource.data.budgetId);

        // Either the budget's controller changes the allocation, or the member
        // it was sent to records their decision - and nothing else.
        allow update: if isMember(hid) && (
                        controlsBudget(hid, resource.data.budgetId)
                        || (
                          resource.data.confirmedBy == uid()
                          && changed().hasOnly(
                               ['status', 'decisionNote', 'decidedAt'])
                        )
                      );

        allow delete: if (isMember(hid)
                          && controlsBudget(hid, resource.data.budgetId))
                      || soleMember(hid);
      }

      // ----------------------------------------------------- approvals
      match /approvals/{aid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid)
                      && request.resource.data.requestedBy == uid()
                      && request.resource.data.requestedFor != uid();

        // Only the recipient answers, and only by writing the decision.
        allow update: if isMember(hid)
                      && resource.data.requestedFor == uid()
                      && changed().hasOnly(
                           ['status', 'decisionNote', 'decidedAt']);

        // Superseded when the allocation it asked about is edited again, or
        // swept up when the budget it belongs to is deleted.
        allow delete: if (isMember(hid) && (
                          resource.data.requestedBy == uid()
                          || controlsBudget(hid, resource.data.budgetId)
                        ))
                      || soleMember(hid);
      }

      // ------------------------------------------------------ expenses
      // Reading is symmetric - the shared ledger is the point of the app - but
      // writing is not: an expense may only be filed against a budget you
      // control. To spend from the other member's budget you ask them to move
      // some of it across (see moneyRequests below).
      //
      // Ownership of the budget, not authorship of the entry, is what grants
      // edit rights. That is also what lets a controller deleting a category
      // detach entries underneath it.
      // `kind` is 'spending' or 'income'. It is checked here so a bad value
      // cannot land in the ledger and be read as the opposite direction: an
      // entry with an unrecognised kind falls back to spending on the client,
      // which for a saving pot would silently reverse it.
      match /expenses/{eid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid)
                      && request.resource.data.spentBy == uid()
                      && controlsBudget(hid, request.resource.data.budgetId)
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.kind in ['spending', 'income'];

        // Both budgets are checked so an entry cannot be moved into a budget
        // the editor does not control.
        allow update: if isMember(hid)
                      && controlsBudget(hid, resource.data.budgetId)
                      && controlsBudget(hid, request.resource.data.budgetId)
                      && request.resource.data.kind in ['spending', 'income'];

        allow delete: if (isMember(hid)
                          && controlsBudget(hid, resource.data.budgetId))
                      || soleMember(hid);
      }

      // ------------------------------------------------- money requests
      // One member asking the other to move money between their budgets.
      //
      // Approving only flips `status`. Neither budget document is touched,
      // because the approver controls the source but not the destination and
      // could not write to both. The transfer is applied client-side when the
      // month is added up, from the requests both members can read.
      match /moneyRequests/{rid} {
        allow read: if isMember(hid);

        // You may only ask on your own behalf, for money to land somewhere you
        // control, out of somewhere you do not. That last clause is what stops
        // this being a way to move money to yourself.
        allow create: if isMember(hid)
                      && request.resource.data.requestedBy == uid()
                      && request.resource.data.requestedFor != uid()
                      && request.resource.data.status == 'pending'
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && controlsBudget(hid, request.resource.data.toBudgetId)
                      && !controlsBudget(hid, request.resource.data.fromBudgetId);

        // Only the source budget's controller decides, and only by writing the
        // decision - the amount cannot be edited while approving.
        //
        // `fromCategoryId` is part of the decision: with no unallocated money
        // left, the approver has to name the category it comes out of. It is
        // writable here and nowhere else, so the asker cannot preselect which
        // of someone else's categories to raid.
        allow update: if isMember(hid)
                      && controlsBudget(hid, resource.data.fromBudgetId)
                      && changed().hasOnly([
                           'status', 'decisionNote', 'decidedAt',
                           'fromCategoryId', 'fromCategoryName'
                         ]);

        // Withdrawing an unanswered request. Safe to delete outright: unlike a
        // category allocation it leaves nothing half-finished behind.
        allow delete: if (isMember(hid)
                          && resource.data.requestedBy == uid()
                          && resource.data.status == 'pending')
                      || soleMember(hid);
      }
    }

    // ------------------------------------------------------------- invites
    // The document id is the secret, so a direct read by code is the whole
    // access check. Listing is closed: codes must never be enumerable.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.acceptedBy == null
                    && isMember(request.resource.data.householdId);

      // Either the inviter manages their own code, or the invitee claims it
      // once - and claiming sets it to themselves.
      allow update: if signedIn() && (
                      resource.data.createdBy == uid()
                      || (
                        resource.data.acceptedBy == null
                        && request.resource.data.acceptedBy == uid()
                      )
                    );

      allow delete: if signedIn() && resource.data.createdBy == uid();
    }
  }
}
