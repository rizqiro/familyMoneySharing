<?xml version="1.0" encoding="utf-8"?>
<!--
  The colour the operating system paints BEFORE any Dart has run.

  Without it the app opens on a white flash, then jumps to the terracotta
  splash a moment later. Matching the two makes the launch look like one
  continuous screen. Keep this in step with `AppColors.light.accent` in
  lib/core/theme/app_colors.dart.
-->
<resources>
    <color name="launch_background">#BE3A20</color>

    <!-- The adaptive icon's background layer. Same terracotta as the launch
         screen and as AppColors.light.accent, so the icon, the system splash
         and the app's first frame are one continuous colour. -->
    <color name="ic_launcher_background">#BE3A20</color>
</resources>
